# 추가 카메라는 CAMERA_1_*, CAMERA_2_* 형태로 등록합니다.

# 기상청 단기예보 조회서비스 실제 인증키
# 공공데이터포털 활용신청 후 발급받은 일반/URL 인코딩 인증키 모두 사용 가능
KMA_SERVICE_KEY=
KMA_NX=102
KMA_NY=94
KMA_STATION_NAME=포항시청
WEATHER_REFRESH_SECONDS=600

# 기상청 API허브 실시간 수집
# 포항 지점 138은 1분 관측주기를 제공하는 포항관측소입니다.
KMA_APIHUB_AUTH_KEY=
KMA_AWS_STATION_ID=138
KMA_AWS_STATION_NAME=포항
KMA_AWS_STATION_LAT=36.03201
KMA_AWS_STATION_LON=129.38002
KMA_AWS_POLL_SECONDS=60
KMA_GRID_POLL_SECONDS=300
KMA_FORECAST_POLL_SECONDS=600
KMA_WEATHER_STALE_SECONDS=180

# 하수도 수위 API (비워두면 데모값)
SEWER_API_URL=
SEWER_API_KEY=
SEWER_REFRESH_SECONDS=60


# 하천 수위 API (비워두면 형산강·냉천·곡강천 데모값)
# 전체 URL을 그대로 넣을 수 있으며 자리표시자 사용 가능:
# {service_key}, {station_code}, {start_date}, {end_date}, {today}
RIVER_API_URL=
RIVER_API_KEY=
RIVER_API_KEY_PARAM=serviceKey
RIVER_API_KEY_HEADER=
RIVER_STATION_CODES=
RIVER_REFRESH_SECONDS=300

# 포항 실시간 CCTV + Stage2 침수분류 모델
POHANG_CCTV_ENABLED=true
POHANG_CCTV_REFRESH_SECONDS=300
STAGE2_MODEL_PATH=weights/best.pt
TIRE_LEVEL_MODEL_PATH=weights/tire_level.pt
CAR_FLOOD_CLS_MODEL_PATH=weights/car_flood_cls.pt
