# 브라우저에서 CCTV 창을 열지 않아도 전체 목록을 순환 추론·기록
BACKGROUND_CCTV_ENABLED=true
BACKGROUND_CCTV_CYCLE_SECONDS=300
BACKGROUND_CCTV_WORKERS=1
BACKGROUND_CCTV_START_DELAY_SECONDS=8
# 0이면 전체 CCTV, 테스트 시에는 5처럼 제한 가능
BACKGROUND_CCTV_MAX_CAMERAS=0
BACKGROUND_CCTV_STORE_LEVEL0=true
# 로컬/테스트 CCTV는 전체 순환과 별도로 15초마다 추론·DB 저장
BACKGROUND_LOCAL_ENABLED=true
BACKGROUND_LOCAL_INTERVAL_SECONDS=15

# OpenCV 연속재생 실패 시 HLS 최신 세그먼트 프레임으로 자동 복구
CCTV_STREAM_FALLBACK_SECONDS=1.5
CCTV_STREAM_ERROR_FRAME_SECONDS=4.0
CCTV_HLS_STALL_RESET_SECONDS=3.5
CCTV_HLS_HARD_RECONNECT_SECONDS=8.0
CCTV_RAW_INTEREST_SECONDS=1.8


# 얼굴·번호판 실시간 모자이크
# 전용 dashcam anonymizer 가중치를 weights/anonymizer_best.pt 에 넣으면 YOLO를 사용합니다.
# 파일이 없으면 OpenCV 얼굴/번호판 보조 탐지기로 자동 동작합니다.
ANONYMIZER_ENABLED=true
ANONYMIZER_MODEL_PATH=weights/anonymizer_best.pt
ANONYMIZER_CONFIDENCE=0.10
ANONYMIZER_IMGSZ=416
ANONYMIZER_INTERVAL_SECONDS=0.70
ANONYMIZER_REFRESH_SECONDS=0.55
ANONYMIZER_BOX_SCALE=1.05
ANONYMIZER_BLOCKS=10
ANONYMIZER_FACE_MAX_AREA_RATIO=0.12
ANONYMIZER_PLATE_MAX_AREA_RATIO=0.035
