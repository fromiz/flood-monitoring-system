STAGE_TRACKING_FRAME_WIDTH=960
# 이 시간보다 오래된 마지막 판정은 지도·목록에서 정상(Lev0)으로 처리
STAGE_STALE_SECONDS=1200
STAGE_EMA_ALPHA=0.35
STAGE_EMA_RESET_SECONDS=8
STAGE_MAJORITY_CONF_WEIGHT=0.0
STAGE_STRICT_MAJORITY=true
STAGE_TRACKING_ENABLED=true
